node_modules
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Next.js build output
.next
out
dist

# Testing
coverage
.nyc_output
*.test.ts
*.test.tsx
*.spec.ts
*.spec.tsx
tests/
test/
__tests__/

# Environment files
.env
.env.local
.env.development
.env.test
.env.production.local

# Git
.git
.gitignore
.gitattributes

# Docker
Dockerfile
.dockerignore
docker-compose.yml
docker-compose.*.yml

# IDE
.vscode
.idea
*.swp
*.swo
*~
.DS_Store

# CI/CD
.github
.gitlab-ci.yml
.travis.yml

# Documentation
README.md
CLAUDE.md
IMPLEMENTATION_PLAN.md
docs/
*.md

